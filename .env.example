# Copy to .env. Read by `felony-api` (pnpm dev:api, db:*), docker compose, and the refresh script.
DATABASE_URL=postgres://felony:felony@localhost:5432/felony
# Bearer token for /admin. Generate one with: openssl rand -hex 24
ADMIN_TOKEN=
# Salt for hashing submitter IPs (only the hash is stored).
IP_SALT=change-me
# Comma-separated origins allowed to call the API cross-origin (only needed if the SPA is hosted elsewhere).
CORS_ORIGIN=
# Set to true only behind a reverse proxy you control (uses the rightmost X-Forwarded-For entry).
TRUST_PROXY=false
# Frontend: API base URL baked in at build time. Leave empty when the API serves the SPA (same origin).
VITE_API_URL=
# Refresh job: model provider key (local `pnpm refresh`, and the refresh container in compose.prod.yml).
ANTHROPIC_API_KEY=

# --- Production (compose.prod.yml) ---
# DATABASE_URL and TRUST_PROXY above are ignored there; the stack wires its own. ADMIN_TOKEN and IP_SALT are required
# (IP_SALT: openssl rand -hex 24).
# Public hostname; point its DNS A/AAAA records at the host first. Use localhost to try the stack locally.
DOMAIN=
# Contact address for Let's Encrypt expiry notices (required; any address works for DOMAIN=localhost).
ACME_EMAIL=
# Hex only, since it is embedded in a connection URL: openssl rand -hex 24
POSTGRES_PASSWORD=
# Image tag to pull from GHCR: latest, or sha-<commit> to pin.
IMAGE_TAG=latest
# Refresh schedule (cron, UTC) and cap per run.
REFRESH_SCHEDULE=17 6 * * *
REFRESH_MAX=10
# Nightly pg_dump into ./backups at this UTC hour, kept this many days.
BACKUP_HOUR=4
BACKUP_KEEP_DAYS=14
