{
  "name": "felony-bench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"pnpm dev:api\"",
    "dev:web": "vite",
    "dev:api": "cargo run --manifest-path api/Cargo.toml -- serve",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b && tsx scripts/validate-data.ts",
    "test": "vitest run",
    "test:api": "cargo test --manifest-path api/Cargo.toml",
    "db:up": "docker compose up -d db",
    "db:migrate": "cargo run --manifest-path api/Cargo.toml -- migrate",
    "db:seed": "cargo run --manifest-path api/Cargo.toml -- seed data/seed",
    "db:export": "cargo run --manifest-path api/Cargo.toml -- export data/seed",
    "refresh": "tsx scripts/refresh-incidents.ts",
    "lint": "oxlint"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.23.0"
}
